# syntax=docker/dockerfile:1.7
# Gitea-runner variant of the local backend quality harness. The repository is
# baked into the build context because the host-mode runners deliberately have
# no Docker daemon with which to mount the checkout. Test execution remains an
# uncached BuildKit stage, while cargo downloads and compiled targets use the
# runner's persistent rootless BuildKit cache mounts.
FROM rust:1.93-bookworm AS toolchain

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 git postgresql-client ca-certificates unzip jq \
      pkg-config make perl libssl-dev zlib1g-dev liblzma-dev libbz2-dev \
 && rm -rf /var/lib/apt/lists/*

RUN ARCH="$(uname -m)" \
 && case "$ARCH" in \
      x86_64)  PA="linux-x86_64" ;; \
      aarch64) PA="linux-aarch_64" ;; \
      *)       echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
    esac \
 && curl --proto '=https' --tlsv1.2 -sSfL \
      "https://github.com/protocolbuffers/protobuf/releases/download/v29.3/protoc-29.3-${PA}.zip" -o /tmp/protoc.zip \
 && unzip -q /tmp/protoc.zip -d /usr/local \
 && rm /tmp/protoc.zip

# All toolchain installers pinned to exact versions confirmed working against
# this toolchain (rustc 1.93.1): sqlx-cli matches the backend's `sqlx = "0.8"`
# (locked at 0.8.6 in Cargo.lock); cargo-nextest/cargo-llvm-cov pinned to the
# last versions observed installing cleanly from prebuilt release binaries.
# This RUN line had been cache-hit (never actually re-executed) for long enough
# that unpinned `sqlx-cli` drifted onto a 0.9.0 release requiring rustc 1.94+
# before anyone noticed. The moment pinning it changed this line's text and
# forced a real rebuild, binstall's GitHub-API-based release lookup started
# intermittently falling back to `cargo install` from source for cargo-nextest
# (which then hard-failed) -- GitHub's unauthenticated 60 req/hour rate limit
# after repeated same-day rebuilds, not a real incompatibility. cargo-nextest
# is therefore now installed directly from its pinned get.nexte.st release
# (see the RUN below), off the GitHub-API path entirely; the two remaining
# binstall targets keep the retry loop for transient rate limits.
# get.nexte.st platform token: x86_64 -> "linux", aarch64 -> "linux-arm" (gnu).
# `cargo nextest --version` right after extraction fails the build loudly if the
# pinned tarball ever stops shipping the expected binary, instead of surfacing as
# a confusing "command not found" mid-test-run.
RUN rustup component add llvm-tools-preview \
 && ARCH="$(uname -m)" \
 && case "$ARCH" in \
      x86_64)  NEXTEST_PLATFORM="linux" ;; \
      aarch64) NEXTEST_PLATFORM="linux-arm" ;; \
      *)       echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
    esac \
 && for attempt in 1 2 3 4 5; do \
      curl --proto '=https' --tlsv1.2 -sSfL \
        "https://get.nexte.st/0.9.138/${NEXTEST_PLATFORM}" -o /tmp/nextest.tar.gz \
      && tar -xzf /tmp/nextest.tar.gz -C "${CARGO_HOME:-/usr/local/cargo}/bin" \
      && rm -f /tmp/nextest.tar.gz && break; \
      echo "nextest download attempt ${attempt} failed" >&2; \
      [ "${attempt}" -eq 5 ] && exit 1; \
      sleep $((attempt * 10)); \
    done \
 && cargo nextest --version \
 && curl -L --proto '=https' --tlsv1.2 -sSf \
      https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash \
 && for attempt in 1 2 3 4 5; do \
      cargo binstall -y cargo-llvm-cov@0.8.7 sqlx-cli@0.8.6 && break; \
      echo "cargo binstall attempt ${attempt} failed" >&2; \
      [ "${attempt}" -eq 5 ] && exit 1; \
      sleep $((attempt * 20)); \
    done

RUN git config --global --add safe.directory '*'

FROM toolchain AS source
ARG DATABASE_URL
ARG COVERAGE_BASE
ARG NEW_CODE_MIN=70
ARG TOTAL_MIN=50
# Workflow env can't reach inside BuildKit; the thread count must arrive as a
# build-arg (ci/backend-quality-k8s.sh forwards it). Default matches the
# proven 8-thread soak configuration.
ARG COVERAGE_TEST_THREADS=8
# Reusing the instrumented target dir across runs is the wall-clock lever, but
# the shared `ak-quality-target` cache mount accumulates object files from
# earlier builds and `cargo llvm-cov report` sums them: on staging PR #49 the
# overall-floor denominator grew 531,770 -> 597,649 -> 599,611 lines across
# three runs of byte-identical source while the covered-line count stayed at
# ~286,690, dropping the reported total from 53.91% to 47.81% and tripping the
# >= 50% floor. Default to a clean run (`cargo llvm-cov clean --workspace`) so
# the report sees only its own objects — a gate that silently decays is worse
# than the ~5 extra minutes on a job that runs alongside the integration legs.
# Soaks/experiments can opt back into reuse with COVERAGE_NO_CLEAN=1.
ARG COVERAGE_NO_CLEAN=0
ENV DATABASE_URL=${DATABASE_URL} \
    COVERAGE_BASE=${COVERAGE_BASE} \
    NEW_CODE_MIN=${NEW_CODE_MIN} \
    TOTAL_MIN=${TOTAL_MIN} \
    SQLX_OFFLINE=true \
    JWT_SECRET=ci-coverage-secret-at-least-32-bytes-long-for-tests \
    CARGO_HOME=/cargo \
    CARGO_TARGET_DIR=/target \
    CARGO_BUILD_JOBS=8 \
    CARGO_INCREMENTAL=1 \
    CARGO_PROFILE_DEV_DEBUG=0 \
    CARGO_PROFILE_TEST_DEBUG=0 \
    CARGO_TERM_COLOR=always \
    COVERAGE_TEST_THREADS=${COVERAGE_TEST_THREADS} \
    COVERAGE_NO_CLEAN=${COVERAGE_NO_CLEAN}

# These pre-existing tests are environment-sensitive in BuildKit: the OTLP
# constructor rejects its hard-coded localhost URI, and the filesystem
# unwritable probe runs as root and can still write through chmod-only
# restrictions. Keep the exclusion narrow; both are unrelated to changed-line
# coverage.
ENV COVERAGE_NEXTEST_FILTER="not test(telemetry::tests::test_build_span_exporter_grpc) and not test(api::handlers::health::tests::test_probe_storage_health_filesystem_unwritable)"

WORKDIR /work
COPY . /work

FROM source AS integration
ARG TEST
ENV TEST=${TEST}
# CACHE_BUST (a fresh value per CI run) forces this RUN to re-execute as a
# normal cache miss. The previous --no-cache-filter approach also RESET the
# cargo/target cache mounts at every solve (BuildKit treats no-cache'd RUNs
# as ignore-cache-mounts too), which is why every lane recompiled the full
# crate graph every run. Tests must always execute; the dep cache must not
# die for it.
ARG CACHE_BUST=0
RUN --mount=type=cache,id=ak-quality-cargo,target=/cargo \
    --mount=type=cache,id=ak-quality-target,target=/target \
    bash -o pipefail -c \
      'echo "cache-bust ${CACHE_BUST}"; bash /work/ci/local-ci/run.sh integration 2>&1 | tee /tmp/integration.log'

RUN mkdir /results && cp /tmp/integration.log /results/

FROM scratch AS integration-results
COPY --from=integration /results/ /

# Compile every backend/tests/*.rs integration-test binary (plus the lib's
# unit tests) exactly ONCE, then copy each executable out of the cargo
# target cache mount into a plain image layer under /test-bin. Pushed once
# per CI run (ci/backend-test-image-build.sh) and reused by every
# backend-integration matrix leg (ci/backend-integration-run-compose.sh), which
# just runs one already-built binary against its own Postgres instead of
# recompiling the whole dev-dependency graph N times. No DATABASE_URL is
# needed here: nothing runs yet, only compiles.
# Compile and extract in ONE RUN: --mount=type=cache paths only exist while
# that specific RUN instruction is executing, not in later RUN instructions
# unless the same mount is re-declared. A separate extraction RUN without
# the /target mount saw an empty directory, so every `cp` failed -- silently,
# since the shell form has no `set -e` by default, so the RUN still exited 0
# with a completely empty /test-bin (discovered by pulling a pushed image
# and finding /test-bin empty; backend-integration-build had been reporting
# success throughout). The heredoc form gets a real `set -euo pipefail` so
# any future extraction failure fails the build loudly instead of silently
# shipping an empty image.
FROM source AS test-artifacts
RUN --mount=type=cache,id=ak-quality-cargo,target=/cargo \
    --mount=type=cache,id=ak-quality-target,target=/target <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
cd /work/artifact-keeper
cargo test --tests --no-run --message-format=json > /tmp/build.json
mkdir -p /test-bin
jq -r 'select(.reason=="compiler-artifact" and .profile.test==true and .executable!=null) | "\(.target.name)\t\(.executable)"' /tmp/build.json \
  | while IFS=$'\t' read -r test_name exe; do cp "${exe}" "/test-bin/${test_name}"; done
ls -la /test-bin
EOF

FROM source AS coverage
# See the integration stage: per-run cache miss WITHOUT resetting the mounts.
ARG CACHE_BUST=0
RUN --mount=type=cache,id=ak-quality-cargo,target=/cargo \
    --mount=type=cache,id=ak-quality-target,target=/target \
    bash -o pipefail -c \
      'echo "cache-bust ${CACHE_BUST}"; bash /work/ci/local-ci/run.sh coverage 2>&1 | tee /tmp/coverage.log'

RUN mkdir /results \
 && cp /tmp/coverage.log /tmp/lcov.info /results/

FROM scratch AS coverage-results
COPY --from=coverage /results/ /

# Upstream-parity lint gate (the `Check Rust` job in upstream ci.yml):
# cargo fmt --check + cargo clippy --workspace --all-targets -- -D warnings.
# SQLX_OFFLINE=true (set in `source`) keeps macro checks on the committed
# .sqlx cache, so no database or migrate step is needed. Shares the cargo/
# target cache mounts with the test stages, so a warm-cache clippy pass is
# cheap. Added after upstream PR #2415's first push failed clippy: the
# coverage lane runs tests but had no fmt/clippy parity, so clippy-only
# breakage stayed invisible until upstream CI.
FROM source AS lint
# The rust:*-bookworm base ships the minimal rustup profile — rustfmt and
# clippy are NOT preinstalled (run 532: "'cargo-fmt' is not installed for
# the toolchain"). Installed here rather than in `toolchain` so the shared,
# long-cached toolchain layer (nextest/binstall downloads) is not
# invalidated for the test stages.
RUN rustup component add rustfmt clippy
# See the integration stage: per-run cache miss WITHOUT resetting the mounts.
ARG CACHE_BUST=0
RUN --mount=type=cache,id=ak-quality-cargo,target=/cargo \
    --mount=type=cache,id=ak-quality-target,target=/target \
    bash -o pipefail -c \
      'echo "cache-bust ${CACHE_BUST}"; bash /work/ci/local-ci/run.sh lint 2>&1 | tee /tmp/lint.log'

RUN mkdir /results && cp /tmp/lint.log /results/

FROM scratch AS lint-results
COPY --from=lint /results/ /
